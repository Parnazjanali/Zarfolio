        <mxCell id="b70idrmCSF3jJlE7nc7l-58" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;create Transaction - unhappy path 401&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
